# Source dynamic HEIC wallpaper
HEIC_FILE="$HOME/Pictures/DynamicWallpapers/Fuji/Fuji.heic"

# Generated frame cache
CACHE_DIR="$HOME/.cache/dynamic-wallpaper/Fuji"

# How often systemd checks the wallpaper
CHECK_INTERVAL_MINUTES=15

# Optional Plasma screen IDs to update, comma-separated.
# Omit this setting to update every connected screen.
# By default, all currently active screens are detected automatically.
# Set SCREEN_IDS only to restrict updates to specific active Plasma screens.
# Temporarily disconnected screens are skipped and retried automatically.
# SCREEN_IDS=0,1

# Schedule mode: embedded (Apple's original clock times) or solar.
# Solar mode warps the embedded timeline around local civil dawn, solar noon,
# and civil dusk while preserving the wallpaper's original frame order.
SCHEDULE_MODE=embedded
# LATITUDE=37.3382
# LONGITUDE=-121.8863
